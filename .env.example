# wan-watchdog stack variables. Copy to .env (never commit .env) and fill in.

# Docker network the watchdog joins (an existing macvlan on your management VLAN works well) and its fixed IP on it
WATCHDOG_NETWORK=mgmt
WATCHDOG_IP=192.168.1.50

# Internet probes: the Docker host's VLAN interface for each WAN-only VLAN (a VLAN the gateway routes out of
# that WAN only, kill switch on). WAN 1 = UniFi's first WAN, WAN 2 = the second.
WAN1_PROBE_PARENT=eth0.71
WAN2_PROBE_PARENT=eth0.72
# VPN probe: the Docker host's VLAN interface for a VLAN routed through a UniFi VPN client only (kill switch on)
VPN_PROBE_PARENT=eth0.75
# Seed the VPN settings on first start (afterwards they're on the Settings page): the VPN's name, its tunnel
# interface on the gateway, and the sites (comma-separated) to check for Cloudflare's "banned your IP" page
VPN_LABEL=VPN
VPN_IFACE=tunovpnc1
VPN_BAN_URLS=https://example.com/

# UniFi gateway (UniFi API + port bounce over SSH)
UNIFI_URL=https://192.168.1.1

# Modems (only needed for the modem-log captures). Page URLs on the Settings page use {ATT_GATEWAY} /
# {QUECTEL_GATEWAY}. 192.168.1.254 is the usual AT&T gateway address, 192.168.225.1 the Quectel default.
ATT_GATEWAY=192.168.1.254
QUECTEL_GATEWAY=192.168.225.1

TZ=America/Los_Angeles

# Secrets
UNIFI_API_KEY=
ADMIN_PASSWORD=
# AT&T gateway "Device Access Code" (sticker on the box) - only needed for its Syslog/Events pages
ATT_ACCESS_CODE=
# Quectel RM520N-GL running QManager: its web UI password (QManager has no user name, leave QUECTEL_USER empty;
# it's only for older web UIs behind an HTTP Basic login)
QUECTEL_USER=
QUECTEL_PASSWORD=
