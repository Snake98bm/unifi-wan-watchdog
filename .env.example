# wan-watchdog stack variables. Copy to .env (never commit .env) and fill in.

# Docker network the watchdog joins (an existing macvlan on your management VLAN works well) and its fixed IP on it
WATCHDOG_NETWORK=mgmt
WATCHDOG_IP=192.168.1.50

# UniFi gateway (UniFi API + port bounce over SSH)
UNIFI_URL=https://192.168.1.1

# Modems (only needed for the modem-log captures). Page URLs on the Settings page use {ATT_GATEWAY} /
# {QUECTEL_GATEWAY}. 192.168.1.254 is the usual AT&T gateway address, 192.168.225.1 the Quectel default.
ATT_GATEWAY=192.168.1.254
QUECTEL_GATEWAY=192.168.225.1

TZ=America/Los_Angeles

# Secrets
UNIFI_API_KEY=
ADMIN_PASSWORD=
# AT&T gateway "Device Access Code" (sticker on the box) - only needed for its Syslog/Events pages
ATT_ACCESS_CODE=
# Login for a Quectel RM520N-GL running the RMIITools toolkit web UI
QUECTEL_USER=
QUECTEL_PASSWORD=
